# Bu dosya ORNEKTIR ve git'e girer. Gercek degerler .env icinde tutulur.
SECRET_KEY=degistir-bunu-rastgele-uzun-bir-metinle
FLASK_ENV=development
DATABASE_URL=siparisn.db
AI_PROVIDER=groq
# Anahtar bos birakilirsa uygulama COKMEZ, demo modunda calisir.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
CORS_ORIGINS=*

# macOS: 5000 portunu AirPlay Receiver kullanir, bu yuzden yerelde 5001.
PORT=5001
